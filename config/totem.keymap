//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        alt_combo {
            bindings = <&kp LEFT_ALT>;
            key-positions = <1 2>;
        };

        right_alt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <3 2>;
        };

        left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <2 33>;
            timeout-ms = <100>;
        };

        right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <33 3>;
            timeout-ms = <100>;
        };

        right_braces {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <33 13>;
            timeout-ms = <100>;
        };

        left_braces {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <33 12>;
            timeout-ms = <100>;
        };

        left_parenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <33 23>;
            timeout-ms = <100>;
        };

        right_parenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <33 24>;
            timeout-ms = <100>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <33 9>;
            timeout-ms = <150>;
        };

        underscore {
            bindings = <&kp UNDER>;
            key-positions = <36 26>;
            timeout-ms = <150>;
        };
    };

    behaviors {
        questionmark: questionmark {
            compatible = "zmk,behavior-tap-dance";
            label = "QUESTIONMARK";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_SHIFT>, <&kp QUESTION>;

            tapping-term-ms = <200>;
        };

        korean: korean {
            compatible = "zmk,behavior-tap-dance";
            label = "KOREAN";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&kp RIGHT_ALT>;

            tapping-term-ms = <300>;
        };

        slash_hold_alt: slash_hold_alt {
            compatible = "zmk,behavior-hold-tap";
            label = "SLASH_HOLD_ALT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        q_hold_alt: q_hold_alt {
            compatible = "zmk,behavior-mod-morph";
            label = "Q_HOLD_ALT";
            bindings = <&kp Q>, <&kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_LCTL)>;
            keep-mods = <(MOD_LALT|MOD_LCTL)>;
        };

        y_hold_one: y_hold_one {
            compatible = "zmk,behavior-mod-morph";
            label = "Y_HOLD_ONE";
            bindings = <&kp Y>, <&kp NUMBER_1>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };

        u_hold_two: u_hold_two {
            compatible = "zmk,behavior-mod-morph";
            label = "U_HOLD_TWO";
            bindings = <&kp U>, <&kp NUMBER_2>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
           &q_hold_alt  &kp W  &kp E                           &kp R      &kp T        &y_hold_one  &u_hold_two  &kp I    &kp O       &kp P
           &kp A        &kp S  &kp D                           &kp F      &kp G        &kp H        &kp J        &kp K    &kp L       &kp SEMI
&kp LCTRL  &kp Z        &kp X  &kp C                           &kp V      &kp B        &kp B        &kp N        &kp M    &kp PERIOD  &kp COMMA  &questionmark
                               &slash_hold_alt LEFT_ALT SLASH  &kp SPACE  &kp SPACE    &mo 2        &korean      &kp TAB
            >;
        };

        nav_num {
            bindings = <
                &none  &kp DELETE  &none  &none           &none             &none            &none            &kp UP_ARROW  &none      &kp BACKSPACE
                &none  &none       &none  &none           &none             &kp HOME         &kp LEFT_ARROW   &kp DOWN      &kp RIGHT  &none
&kp LEFT_SHIFT  &none  &none       &none  &none           &kp UNDER         &none            &kp END          &kp ENTER     &none      &none          &kp BACKSPACE
                                   &none  &kp LEFT_SHIFT  &kp LEFT_SHIFT    &kp RIGHT_SHIFT  &kp RIGHT_SHIFT  &none
            >;
        };

        sym_func {
            bindings = <
           &none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3    &none             &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PLUS   &kp MINUS          &kp BACKSPACE
           &none  &kp NUMBER_4  &kp N5        &kp NUMBER_6    &none             &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL  &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE
&kp GRAVE  &none  &kp N7        &kp N8        &kp N9          &kp UNDERSCORE    &kp LESS_THAN         &kp GREATER_THAN       &kp UNDER  &none              &kp F15           &kp F5
                                &kp N0        &kp LEFT_SHIFT  &kp LEFT_SHIFT    &none                 &kp RIGHT_SHIFT        &none
            >;
        };

        device {
            bindings = <
       &none       &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none             &none    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
       &kp K_MUTE  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_PLAY_PAUSE  &none    &none         &none         &none         &none         &none
&none  &none       &none                 &none                 &none             &none    &none         &none         &none         &none         &none         &bt BT_CLR
                                         &none                 &none             &none    &none         &none         &none
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        alt_combo {
            bindings = <&kp LEFT_ALT>;
            key-positions = <1 2>;
        };

        shift_combo {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <11 12>;
        };

        esc_combo {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        right_alt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <3 2>;
        };
    };

    behaviors {
        questionmark: questionmark {
            compatible = "zmk,behavior-tap-dance";
            label = "QUESTIONMARK";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_SHIFT>, <&kp QUESTION>;

            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
           &kp Q  &kp W  &kp E      &kp R      &kp T        &kp Y  &kp U  &kp I    &kp O       &kp P
           &kp A  &kp S  &kp D      &kp F      &kp G        &kp H  &kp J  &kp K    &kp L       &kp SEMI
&kp LCTRL  &kp Z  &kp X  &kp C      &kp V      &kp B        &kp B  &kp N  &kp M    &kp PERIOD  &kp COMMA  &questionmark
                         &kp SLASH  &kp SPACE  &kp SPACE    &mo 2  &mo 1  &kp TAB
            >;
        };

        nav_num {
            bindings = <
                &none  &kp DELETE  &none  &none           &none             &none            &kp HOME         &kp UP_ARROW  &kp END        &kp BACKSPACE
                &none  &none       &none  &none           &none             &none            &kp LEFT_ARROW   &kp DOWN      &kp RIGHT      &none
&kp LEFT_SHIFT  &none  &none       &none  &none           &kp UNDER         &none            &none            &kp ENTER     &kp BACKSPACE  &none          &kp F5
                                   &none  &kp LEFT_SHIFT  &kp LEFT_SHIFT    &kp RIGHT_SHIFT  &kp RIGHT_SHIFT  &none
            >;
        };

        sym_func {
            bindings = <
           &none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3    &none             &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PLUS   &kp MINUS          &kp BACKSPACE
           &none  &kp NUMBER_4  &kp N5        &kp NUMBER_6    &none             &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL  &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE
&kp GRAVE  &none  &kp N7        &kp N8        &kp N9          &kp UNDERSCORE    &kp LESS_THAN         &kp GREATER_THAN       &kp UNDER  &none              &kp F15           &kp F5
                                &kp N0        &kp LEFT_SHIFT  &kp LEFT_SHIFT    &none                 &kp RIGHT_SHIFT        &none
            >;
        };

        device {
            bindings = <
       &none       &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none             &none    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
       &kp K_MUTE  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_PLAY_PAUSE  &none    &none         &none         &none         &none         &none
&none  &none       &none                 &none                 &none             &none    &none         &none         &none         &none         &none         &bt BT_CLR
                                         &none                 &none             &none    &none         &none         &none
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};

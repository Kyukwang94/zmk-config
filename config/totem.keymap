#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

&lt {
    quick-tap-ms = <200>;
    tapping-term-ms = <180>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_capsword {
            timeout-ms = <50>;
            key-positions = <13 16>;
            bindings = <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
                &kp Q       &kp W       &kp E       &kp R       &kp T         &kp Y       &kp U       &kp I       &kp O       &kp P
                &kp A       &kp S       &kp D       &kp F       &kp G         &kp H       &kp J       &kp K       &kp L       &kp SEMI
&kp ESC         &kp Z       &kp X       &kp C       &kp V       &kp B         &kp B       &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH
                                        &kp TAB     &mo NAV     &kp LSHFT     &kp SPACE   &mo SYM     &kp BSPC
            >;
        };

        nav_layer {
            label = "NAV";
            bindings = <
                &none       &none       &none       &none       &none         &kp PG_UP   &kp HOME    &kp UP      &kp END     &none
                &kp LCTRL   &kp LALT    &kp LGUI    &kp LSHFT   &none         &kp PG_DN   &kp LEFT    &kp DOWN    &kp RIGHT   &none
&none           &none       &none       &none       &none       &none         &none       &none       &none       &none       &none       &none
                                        &trans      &trans      &trans        &kp ENTER   &mo ADJ     &kp DEL
            >;
        };

        sym_layer {
            label = "SYM";
            bindings = <
                &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT     &kp CARET   &kp AMPS    &kp ASTRK   &kp LPAR    &kp RPAR
                &kp N1      &kp N2      &kp N3      &kp N4      &kp N5        &kp N6      &kp N7      &kp N8      &kp N9      &kp N0
&none           &kp MINUS   &kp EQUAL   &kp LBKT    &kp RBKT    &kp BSLH      &kp GRAVE   &none       &none       &none       &none       &none
                                        &trans      &mo ADJ     &trans        &trans      &trans      &trans
            >;
        };

        adj_layer {
            label = "ADJ";
            bindings = <
                &bootloader &none       &none       &none       &out OUT_TOG  &none       &kp F7      &kp F8      &kp F9      &kp F12
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR &none     &kp F4      &kp F5      &kp F6      &kp F11
&none           &none       &none       &none       &none       &none         &none       &kp F1      &kp F2      &kp F3      &kp F10     &none
                                        &trans      &trans      &trans        &trans      &trans      &trans
            >;
        };
    };
};
